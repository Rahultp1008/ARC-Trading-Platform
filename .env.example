# ─────────────────────────────────────────────────────────────────────────────
# ARC Trading Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/arc_trading

# ── JWT Secrets (generate with: openssl rand -hex 32) ────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-change-this-in-production

# ── Token Lifetimes ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Algorithm ─────────────────────────────────────────────────────────────────
ALGORITHM=HS256

# ── Instrument Integrations (Module 4) ───────────────────────────────────────
# Get from Kite Connect developer portal: https://developers.kite.trade
KITE_API_KEY=your_kite_api_key
KITE_ACCESS_TOKEN=your_kite_access_token

# Binance API (optional for paper trading, public endpoints work without key)
BINANCE_API_KEY=your_binance_api_key

# ── Superadmin Seeding (used by create_superadmin.py) ────────────────────────
SUPERADMIN_EMAIL=admin@arc.com
SUPERADMIN_PASSWORD=Admin@1234
