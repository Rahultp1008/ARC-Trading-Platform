# ══════════════════════════════════════════════════════════════════════════
# ARC Trading Platform — Complete .env (Modules 1–5)
# ══════════════════════════════════════════════════════════════════════════
# IMPORTANT: Never commit this file to git.
# Copy this file to your project root as .env and fill in real values.
# ══════════════════════════════════════════════════════════════════════════


# ── MODULE 1 — Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:Admin1234@localhost:5432/arc_trading
DB_ECHO=False


# ── MODULE 1 — JWT Auth ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
REFRESH_SECRET_KEY=f0e1d2c3b4a5f6e7d8c9b0a1f2e3d4c5b6a7f8e9d0c1b2a3f4e5d6c7b8a9f0e1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── MODULE 1 — App Environment ─────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production


# ── MODULE 2 — Super Admin Seed ────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@arc.com
SUPERADMIN_PASSWORD=Admin@1234


# ── MODULE 3 — KYC Document Storage ───────────────────────────────────────
# Set these when connecting to S3 or any file storage for KYC documents
# KYC_STORAGE_BUCKET=arc-kyc-documents
# KYC_STORAGE_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key


# ── MODULE 4 — Kite Connect (NSE Instruments + Live Ticks) ─────────────────
# Get from: https://developers.kite.trade
# Access token expires daily — must be refreshed via Kite login flow
KITE_API_KEY=your_kite_api_key
KITE_ACCESS_TOKEN=your_kite_access_token
KITE_WS_API_KEY=your_kite_ws_api_key
KITE_WS_ACCESS_TOKEN=your_kite_ws_access_token


# ── MODULE 4 — Binance (Crypto Instruments + Live Ticks) ───────────────────
# Public market data endpoints do not require API key
# API key only needed for placing real orders (not in MVP scope)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key


# ── MODULE 5 — Redis (Optional — falls back to in-memory if not running) ───
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20


# ── MODULE 5 — Quote Staleness Thresholds (seconds) ───────────────────────
# is_quote_stale() returns True if a price is older than these values
# NSE/BSE equity: stale after 5 seconds
# Binance crypto: stale after 10 seconds (24/7 market)
# All others:     stale after 15 seconds
QUOTE_STALE_THRESHOLD_EQUITY=5
QUOTE_STALE_THRESHOLD_CRYPTO=10
QUOTE_STALE_THRESHOLD_DEFAULT=15


# ── MODULE 5 — OHLC Candle Config ─────────────────────────────────────────
# How long to keep intraday candles in Redis (seconds)
# 86400 = 24 hours
OHLC_CANDLE_TTL_SECONDS=86400


# ── MODULE 5 — WebSocket Config ───────────────────────────────────────────
# Maximum concurrent WebSocket connections allowed
WS_MAX_CONNECTIONS=100
# How often to send heartbeat ping to connected clients (seconds)
WS_HEARTBEAT_INTERVAL=30


# ── MODULE 5 — Binance WebSocket Base URL ─────────────────────────────────
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws